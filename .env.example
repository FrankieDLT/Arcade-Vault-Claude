# Resend API key (https://resend.com/api-keys). Server-only: never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# Inbox that receives contact form messages.
# With the Resend sandbox sender (onboarding@resend.dev) this must be the email of the Resend account owner.
CONTACT_TO_EMAIL=

SUPABASE_DB_PASSWORD=

# Supabase project URL (Project Settings > API).
# NEXT_PUBLIC_ values are inlined at build time: restart `npm run dev` after editing.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...). Safe for browsers; protected by RLS.
# Never put the service role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
