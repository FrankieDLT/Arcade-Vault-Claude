# Contact form: RESEND_API_KEY and CONTACT_TO_EMAIL are now secrets of the Supabase Edge Function `contact`
# (Dashboard > Edge Functions > Secrets). They are NOT read by the Next.js app and must not live here.

# Sub-path for GitHub Pages (CI sets /Arcade-Vault-Claude). Leave empty for local dev.
NEXT_PUBLIC_BASE_PATH=

SUPABASE_DB_PASSWORD=

# Supabase project URL (Project Settings > API).
# NEXT_PUBLIC_ values are inlined at build time: restart `npm run dev` after editing.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...). Safe for browsers; protected by RLS.
# Never put the service role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
